<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- DARRELLBEST-FORK (bump on every upstream version change): this module has no upstream
         counterpart, so upstream's version-bump commits update every OTHER pom and silently leave
         this one behind. The build then fails only at Mage.Tests, with a confusing
         "mage-bench:jar:<new> has not been downloaded" error that looks like a repository problem
         rather than a stale parent version. Same applies to Mage.Bridge and
         Mage.Player.AI.Commander. -->
    <parent>
        <groupId>org.mage</groupId>
        <artifactId>mage-root</artifactId>
        <version>1.4.61</version>
    </parent>

    <artifactId>mage-bench</artifactId>
    <packaging>jar</packaging>
    <name>Mage Bench (headless AI-vs-AI benchmark)</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-sets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-game-twoplayerduel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-game-commanderduel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- DARRELLBEST-FORK: multiplayer commander pods (gameType commanderffa) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-game-commanderfreeforall</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-player-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-player-ai-mad</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-player-ai-mcts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>mage-player-ai-commander</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <properties>
        <root.dir>${project.basedir}/..</root.dir>
    </properties>

</project>
